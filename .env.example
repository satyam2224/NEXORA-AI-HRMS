# Supabase (frontend) — public keys, safe to commit
# Copy this file to .env and replace the placeholders with your project's values.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# ─────────────────────────────────────────────────────────────
# Supabase Edge Function secrets (server-side only, NOT in .env)
# Set these in the Supabase Dashboard → Edge Functions → Secrets,
# or via the Supabase MCP tools. NEVER commit real keys to git.
# ─────────────────────────────────────────────────────────────

# AI provider: "openai" (default), "openrouter", "together", "groq", or any
# OpenAI-compatible endpoint (local llama.cpp /v1, etc.)
AI_PROVIDER=openai

# Your LLM API key — kept server-side only
AI_API_KEY=sk-your-llm-api-key

# Model name (provider-specific)
AI_MODEL=gpt-4o-mini

# Base URL for an OpenAI-compatible chat completions endpoint.
# Defaults to https://api.openai.com/v1. Override for OpenRouter, etc.
AI_BASE_URL=https://api.openai.com/v1
